{
  "name": "Login",
  "method": "POST",
  "path": "user/login",
  "description": "Login to an existing account and receive tokens.",
  "body": {
    "phone": "+1234567890",
    "password": "password123",
    "device_id": "device_12345"
  },
  "test": [
    "pm.test('Save access token', () => {",
    "    let res = pm.response.json();",
    "    if (res.success && res.data && res.data.access_token) {",
    "        pm.environment.set('access_token', res.data.access_token);",
    "    }",
    "    if (res.success && res.data && res.data.refresh_token) {",
    "        pm.environment.set('refresh_token', res.data.refresh_token);",
    "    }",
    "});"
  ],
  "responses": [
    {
      "name": "200 - OK",
      "code": 200,
      "body": {
        "success": true,
        "data": {
          "user": {
            "id": 1,
            "name": "John Doe",
            "email": "john@example.com"
          },
          "access_token": "3|abcdefg...",
          "refresh_token": "4|hijklmn..."
        },
        "meta": {
          "message": "Logged in successfully"
        }
      }
    }
  ]
}
