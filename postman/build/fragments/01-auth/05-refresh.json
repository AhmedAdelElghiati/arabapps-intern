{
  "name": "Refresh Token",
  "method": "POST",
  "path": "user/refresh",
  "description": "Refresh the access token using the refresh token.",
  "auth": "bearer",
  "prerequest": [
    "pm.request.auth.bearer.token = pm.environment.get('refreshToken');"
  ],
  "body": {},
  "test": [
    "pm.test('Save access token', () => {",
    "    let res = pm.response.json();",
    "    if (res.success && res.data && res.data.access_token) {",
    "        pm.environment.set('accessToken', res.data.access_token);",
    "    }",
    "});"
  ]
}
